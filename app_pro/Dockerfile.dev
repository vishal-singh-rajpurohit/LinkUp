# Stage 1: Build the frontend application
FROM node:20-slim AS builder
WORKDIR /app

# Build arguments for Vite
ARG VITE_BASE_URL=http://localhost:5173
ARG VITE_API=http://localhost:5173/api/v1
ARG VITE_API_=http://localhost:5173
ARG VITE_API_EMOJI_API_KEY=t9898u8omq3c23slaepfgdhwf6kjm63o7324pfvyxhgukn3b
ARG VITE_API_CHAT_SECRET_KEY=2f3c4a1e8d7b9c0a6f5d4e3b2a1908ff0a1b2c3d4e5f67890123456789abcdef

ENV VITE_BASE_URL=$VITE_BASE_URL
ENV VITE_API=$VITE_API
ENV VITE_API_=$VITE_API_
ENV VITE_API_EMOJI_API_KEY=$VITE_API_EMOJI_API_KEY
ENV VITE_API_CHAT_SECRET_KEY=$VITE_API_CHAT_SECRET_KEY

COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

# Stage 2: Serve with Nginx
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.dev.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]